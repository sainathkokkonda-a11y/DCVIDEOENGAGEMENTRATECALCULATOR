<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Video Engagement Rate Calculator</title>
  <style>
    * {
      box-sizing: border-box;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    body {
      background-color: #f4f7f9;
      margin: 0;
      padding: 20px;
    }
    .tool-card {
      max-width: 650px;
      margin: 20px auto;
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
      overflow: hidden;
      border: 1px solid #e1e8ed;
    }
    .tool-header {
      background-color: #1565c0;
      color: #ffffff;
      padding: 24px 20px;
      text-align: center;
    }
    .tool-header h1 {
      margin: 0 0 6px 0;
      font-size: 22px;
      font-weight: 700;
    }
    .tool-header p {
      margin: 0;
      font-size: 13px;
      opacity: 0.9;
    }
    .tool-body {
      padding: 24px;
    }
    .step-group {
      margin-bottom: 16px;
    }
    .step-label {
      color: #1565c0;
      font-weight: 700;
      font-size: 14px;
      margin-bottom: 6px;
      display: block;
    }
    input[type="number"] {
      width: 100%;
      padding: 12px;
      border: 1px solid #bce0fd;
      border-radius: 8px;
      font-size: 15px;
      outline: none;
      background-color: #fafcfe;
      transition: border-color 0.2s;
    }
    input[type="number"]:focus {
      border-color: #1565c0;
      background-color: #ffffff;
    }
    .btn-container {
      display: flex;
      gap: 10px;
      margin-top: 20px;
      margin-bottom: 20px;
    }
    .action-btn {
      flex: 1;
      background-color: #1565c0;
      color: white;
      border: none;
      padding: 12px;
      border-radius: 6px;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
    }
    .action-btn:hover {
      background-color: #0d47a1;
    }
    .clear-btn {
      background-color: #e0e0e0;
      color: #333;
    }
    .clear-btn:hover {
      background-color: #d6d6d6;
    }
    .result-box {
      background-color: #e3f2fd;
      border: 1px solid #90caf9;
      border-radius: 8px;
      padding: 16px;
      text-align: center;
      display: none;
    }
    .result-title {
      font-size: 13px;
      color: #1565c0;
      font-weight: 700;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    .result-value {
      font-size: 28px;
      font-weight: 800;
      color: #0d47a1;
    }
    .result-status {
      font-size: 13px;
      font-weight: 600;
      margin-top: 6px;
    }
  </style>
</head>
<body>

<div class="tool-card">
  <div class="tool-header">
    <h1>Video Engagement Rate Calculator</h1>
    <p>Calculate Engagement Rate for YouTube, Instagram Reels &amp; TikTok</p>
  </div>

  <div class="tool-body">
    <div class="step-group">
      <label class="step-label">1. Total Views</label>
      <input id="views" min="0" placeholder="e.g. 10000" type="number">
    </div>

    <div class="step-group">
      <label class="step-label">2. Total Likes</label>
      <input id="likes" min="0" placeholder="e.g. 500" type="number">
    </div>

    <div class="step-group">
      <label class="step-label">3. Total Comments</label>
      <input id="comments" min="0" placeholder="e.g. 50" type="number">
    </div>

    <div class="step-group">
      <label class="step-label">4. Total Shares (Optional)</label>
      <input id="shares" min="0" placeholder="e.g. 20" type="number">
    </div>

    <div class="btn-container">
      <button class="action-btn" onclick="calculateRate()">Calculate</button>
      <button class="action-btn clear-btn" onclick="clearFields()">Clear</button>
    </div>

    <div class="result-box" id="resultBox">
      <div class="result-title">Engagement Rate</div>
      <div class="result-value" id="rateValue">0.00%</div>
      <div class="result-status" id="statusText"></div>
    </div>
  </div>
</div>

<script>
  function calculateRate() {
    const views = parseFloat(document.getElementById('views').value) || 0;
    const likes = parseFloat(document.getElementById('likes').value) || 0;
    const comments = parseFloat(document.getElementById('comments').value) || 0;
    const shares = parseFloat(document.getElementById('shares').value) || 0;

    if (views <= 0) {
      alert('Please enter a valid number of views greater than 0.');
      return;
    }

    const totalInteractions = likes + comments + shares;

    // Added validation to prevent incorrect/absurd percentages when interactions exceed views
    if (totalInteractions > views) {
      alert('Total interactions (Likes + Comments + Shares) cannot exceed Total Views. Please check your numbers.');
      return;
    }

    const engagementRate = (totalInteractions / views) * 100;

    document.getElementById('rateValue').innerText = engagementRate.toFixed(2) + '%';
    
    const status = document.getElementById('statusText');
    if (engagementRate < 1) {
      status.innerText = 'Low Engagement Rate';
      status.style.color = '#d32f2f';
    } else if (engagementRate >= 1 && engagementRate <= 3.5) {
      status.innerText = 'Average Engagement Rate';
      status.style.color = '#f57c00';
    } else {
      status.innerText = 'High & Excellent Engagement Rate!';
      status.style.color = '#2e7d32';
    }

    document.getElementById('resultBox').style.display = 'block';
  }

  function clearFields() {
    document.getElementById('views').value = '';
    document.getElementById('likes').value = '';
    document.getElementById('comments').value = '';
    document.getElementById('shares').value = '';
    document.getElementById('resultBox').style.display = 'none';
  }
</script>

</body>
</html>
